<!DOCTYPE html>
<!-- server/views/posts/edit.ejs - טופס עריכת פוסט (FR-014) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h1>עריכת פוסט</h1>
    <% if (typeof error !== 'undefined' && error) { %><p class="error-message"><%= error %></p><% } %>
    <form action="/posts/<%= post.id %>?_method=PUT" method="POST" class="auth-form">
      <label for="title">כותרת</label>
      <input type="text" id="title" name="title" required maxlength="150" value="<%= post.title %>" />

      <label for="content">תוכן</label>
      <textarea id="content" name="content" required maxlength="5000"><%= post.content %></textarea>

      <label for="category">קטגוריה</label>
      <select id="category" name="category">
        <option value="dvarTorah" <%= post.category === 'dvarTorah' ? 'selected' : '' %>>דבר תורה</option>
        <option value="question" <%= post.category === 'question' ? 'selected' : '' %>>שאלה</option>
        <option value="update" <%= post.category === 'update' ? 'selected' : '' %>>עדכון</option>
        <option value="holiday" <%= post.category === 'holiday' ? 'selected' : '' %>>חג</option>
      </select>

      <button type="submit">שמירת שינויים</button>
    </form>
    <hr />
    <h2>וידאו מצורף</h2>
    <% if (post.videoUrl) { %>
      <video class="post-video" controls src="<%= post.videoUrl %>"></video>
      <p class="meta">להחלפת הווידאו, העלה קובץ חדש למטה - הוא יחליף את הקיים.</p>
    <% } else { %>
      <p class="meta">אין עדיין וידאו מצורף לפוסט הזה.</p>
    <% } %>
    <form action="/posts/<%= post.id %>/video" method="POST" enctype="multipart/form-data" class="auth-form">
      <label for="video">קובץ וידאו (mp4/webm, עד 50MB)</label>
      <input type="file" id="video" name="video" accept="video/mp4,video/webm" required />
      <button type="submit">העלאת וידאו</button>
    </form>

    <hr />
    <h2>גלריית תמונות</h2>
    <!-- גלריית תמונות לפוסט - עד 6 תמונות בסה"כ, מצטרפות לקיימות (server/models/Post.js addImages) -->
    <% if (post.imageUrls && post.imageUrls.length) { %>
      <div class="image-gallery">
        <% post.imageUrls.forEach(function (url) { %>
          <img src="<%= url %>" class="gallery-thumb" alt="תמונה מצורפת לפוסט" />
        <% }) %>
      </div>
      <p class="meta"><%= post.imageUrls.length %> מתוך 6 תמונות אפשריות.</p>
    <% } else { %>
      <p class="meta">אין עדיין תמונות בפוסט הזה.</p>
    <% } %>
    <% if (!post.imageUrls || post.imageUrls.length < 6) { %>
      <form action="/posts/<%= post.id %>/images" method="POST" enctype="multipart/form-data" class="auth-form">
        <label for="images">הוספת תמונות (JPG/PNG/WEBP/GIF, עד 5MB לתמונה)</label>
        <input type="file" id="images" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple required />
        <button type="submit">העלאת תמונות</button>
      </form>
    <% } %>

    <p><a href="/groups/<%= post.groupId %>">חזרה לקבוצה</a></p>
  </main>
</body>
</html>
