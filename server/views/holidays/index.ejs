<!DOCTYPE html>
<!-- server/views/holidays/index.ejs - עמוד "מעגל השנה" (FR-029) - ציבורי, כולל לאורחים -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <h1>מעגל השנה</h1>
    <p class="meta">מאמרים קצרים על מועדי ומנהגי השנה העברית - מה עושים, מה מתפללים ומה המנהגים העיקריים בכל חג.</p>

    <% if (isLoggedIn && userRole === 'admin') { %>
      <p><a class="btn btn-primary" href="/holidays/new">+ הוספת מאמר חג</a></p>
    <% } %>

    <!--
      ===== לוח שנה גרגוריאני ויזואלי (עדכון לפי בקשת המשתמש - לוח גריד אמיתי, לא רק רשימת מאמרים) =====
      חשוב: זהו לוח לועזי רגיל בלבד (server/utils/calendarGrid.js) - בלי שום חישוב אסטרונומי של הלוח העברי
      (מחוץ להיקף המערכת, סעיף 2.2 ב-SRS). חג מסומן בלוח רק אם הוגדר לו ידנית תאריך לועזי (gregorianDate).
    -->
    <h2>לוח שנה - 12 החודשים הקרובים</h2>
    <div class="year-grid">
      <% calendarMonths.forEach(function (m) { %>
        <div class="mini-calendar">
          <h4><%= m.monthName %> <%= m.year %></h4>
          <table class="mini-calendar-table">
            <thead>
              <tr>
                <% ['א','ב','ג','ד','ה','ו','ש'].forEach(function (letter) { %><th><%= letter %></th><% }) %>
              </tr>
            </thead>
            <tbody>
              <% m.weeks.forEach(function (week) { %>
                <tr>
                  <% week.forEach(function (cell) { %>
                    <% if (!cell) { %>
                      <td></td>
                    <% } else if (cell.holidays.length) { %>
                      <td class="cal-day has-holiday<%= cell.isToday ? ' is-today' : '' %>">
                        <a href="/holidays/<%= cell.holidays[0].id %>" title="<%= cell.holidays.map(function (h) { return h.holidayName; }).join(', ') %>"><%= cell.day %></a>
                      </td>
                    <% } else { %>
                      <td class="cal-day<%= cell.isToday ? ' is-today' : '' %>"><%= cell.day %></td>
                    <% } %>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% }) %>
    </div>

    <% if (featured) { %>
      <!-- המועד הקרוב מוצג בהבלטה - מסומן ידנית ע"י האדמין (Holiday.isFeatured), ללא חישוב אסטרונומי (מחוץ להיקף) -->
      <section class="card holiday-featured">
        <span class="role-badge">המועד הקרוב</span>
        <h2><a href="/holidays/<%= featured.id %>"><%= featured.holidayName %></a></h2>
        <% if (featured.dateHint) { %><p class="meta"><%= featured.dateHint %></p><% } %>
        <% if (featured.whatWeDo) { %><p><%= featured.whatWeDo %></p><% } %>
        <p><a href="/holidays/<%= featured.id %>">לקריאה מלאה ←</a></p>
      </section>
    <% } %>

    <h2>ארכיון מועדים</h2>
    <% if (!archive.length) { %>
      <p class="meta">עדיין אין מועדים נוספים בארכיון.</p>
    <% } else { %>
      <!-- דרישה 27.iii - multiple-columns: ארכיון המועדים מוצג בפריסת עמודות מרובות -->
      <div class="digest-columns">
        <% archive.forEach(function (h) { %>
          <div class="card holiday-card">
            <h3><a href="/holidays/<%= h.id %>"><%= h.holidayName %></a></h3>
            <% if (h.dateHint) { %><p class="meta"><%= h.dateHint %></p><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
