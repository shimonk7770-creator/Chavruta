<!DOCTYPE html>
<!-- server/views/holidays/index.ejs - עמוד "מעגל השנה" (FR-029) - ציבורי, כולל לאורחים -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <h1>מעגל השנה</h1>
    <p class="meta">מאמרים קצרים על מועדי ומנהגי השנה העברית - מה עושים, מה מתפללים ומה המנהגים העיקריים בכל חג.</p>

    <% if (isLoggedIn && userRole === 'admin') { %>
      <p><a class="btn btn-primary" href="/holidays/new">+ הוספת מאמר חג</a></p>
    <% } %>

    <!--
      ===== לוח שנה גרגוריאני ויזואלי (עדכון לפי בקשת המשתמש - חודש נוכחי בודד + ניווט, במקום 12 חודשים יחד) =====
      חשוב: זהו לוח לועזי רגיל בלבד (server/utils/calendarGrid.js) - בלי שום חישוב אסטרונומי של הלוח העברי
      (מחוץ להיקף המערכת, סעיף 2.2 ב-SRS). חג מסומן בלוח רק אם הוגדר לו ידנית תאריך לועזי (gregorianDate),
      ומודגש בצבע מיוחד (רקע כתום + מסגרת) כדי שיהיה קל לזהות אותו בלוח.
    -->
    <div class="calendar-card">
      <div class="calendar-nav">
        <a class="calendar-nav-btn" href="/holidays?year=<%= prev.year %>&month=<%= prev.month %>">‹ חודש קודם</a>
        <h2 class="calendar-title"><%= calendarMonth.monthName %> <%= calendarMonth.year %></h2>
        <a class="calendar-nav-btn" href="/holidays?year=<%= next.year %>&month=<%= next.month %>">חודש הבא ›</a>
      </div>
      <% if (!isCurrentMonth) { %>
        <p class="calendar-today-link"><a href="/holidays?year=<%= todayYear %>&month=<%= todayMonth1based %>">↺ חזרה לחודש הנוכחי</a></p>
      <% } %>
      <table class="full-calendar-table">
        <thead>
          <tr>
            <% ['א','ב','ג','ד','ה','ו','ש'].forEach(function (letter) { %><th><%= letter %></th><% }) %>
          </tr>
        </thead>
        <tbody>
          <% calendarMonth.weeks.forEach(function (week) { %>
            <tr>
              <% week.forEach(function (cell) { %>
                <% if (!cell) { %>
                  <td></td>
                <% } else if (cell.holidays.length) { %>
                  <td class="cal-day-full has-holiday<%= cell.isToday ? ' is-today' : '' %>">
                    <a href="/holidays/<%= cell.holidays[0].id %>" title="<%= cell.holidays.map(function (h) { return h.holidayName; }).join(', ') %>">
                      <span class="cal-day-num"><%= cell.day %></span>
                      <span class="cal-day-holiday-label"><%= cell.holidays[0].holidayName %></span>
                    </a>
                  </td>
                <% } else { %>
                  <td class="cal-day-full<%= cell.isToday ? ' is-today' : '' %>"><span class="cal-day-num"><%= cell.day %></span></td>
                <% } %>
              <% }) %>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="calendar-legend"><span class="legend-swatch legend-holiday"></span> יום עם חג/מועד מסומן &nbsp;&nbsp; <span class="legend-swatch legend-today"></span> היום</p>
    </div>

    <% if (featured) { %>
      <!-- המועד הקרוב מוצג בהבלטה - מסומן ידנית ע"י האדמין (Holiday.isFeatured), ללא חישוב אסטרונומי (מחוץ להיקף) -->
      <section class="card holiday-featured">
        <span class="role-badge">המועד הקרוב</span>
        <h2><a href="/holidays/<%= featured.id %>"><%= featured.holidayName %></a></h2>
        <% if (featured.dateHint) { %><p class="meta"><%= featured.dateHint %></p><% } %>
        <% if (featured.whatWeDo) { %><p><%= featured.whatWeDo %></p><% } %>
        <p><a href="/holidays/<%= featured.id %>">לקריאה מלאה ←</a></p>
      </section>
    <% } %>

    <h2>ארכיון מועדים</h2>
    <% if (!archive.length) { %>
      <p class="meta">עדיין אין מועדים נוספים בארכיון.</p>
    <% } else { %>
      <!-- דרישה 27.iii - multiple-columns: ארכיון המועדים מוצג בפריסת עמודות מרובות -->
      <div class="digest-columns">
        <% archive.forEach(function (h) { %>
          <div class="card holiday-card">
            <h3><a href="/holidays/<%= h.id %>"><%= h.holidayName %></a></h3>
            <% if (h.dateHint) { %><p class="meta"><%= h.dateHint %></p><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
