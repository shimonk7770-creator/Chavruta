<!DOCTYPE html>
<!-- server/views/holidays/edit.ejs - טופס עריכת מאמר חג קיים (FR-028, אדמין בלבד) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h1>עריכת מאמר חג</h1>
    <% if (error) { %><p class="error-message"><%= error %></p><% } %>

    <form action="/holidays/<%= holiday.id %>" method="POST" class="auth-form">
      <label for="holidayName">שם החג</label>
      <input type="text" id="holidayName" name="holidayName" required maxlength="80" value="<%= holiday.holidayName %>" />

      <label for="dateHint">תיאור המועד</label>
      <input type="text" id="dateHint" name="dateHint" maxlength="150" value="<%= holiday.dateHint %>" />

      <label for="gregorianDate">תאריך לועזי מדויק לשנה זו (אופציונלי - כדי שהחג יופיע בלוח השנה הגרפי למעלה)</label>
      <input type="date" id="gregorianDate" name="gregorianDate" value="<%= holiday.gregorianDate || '' %>" />
      <p class="meta" style="margin-top:-8px">אם לא מוזן, החג יופיע רק בארכיון המאמרים למטה - כי אין באתר חישוב אוטומטי של הלוח העברי.</p>

      <label for="whatWeDo">מה עושים</label>
      <textarea id="whatWeDo" name="whatWeDo" maxlength="2000"><%= holiday.whatWeDo %></textarea>

      <label for="whatWePray">מה מתפללים</label>
      <textarea id="whatWePray" name="whatWePray" maxlength="2000"><%= holiday.whatWePray %></textarea>

      <label for="customs">מנהגים עיקריים</label>
      <textarea id="customs" name="customs" maxlength="2000"><%= holiday.customs %></textarea>

      <label for="linkedGroupId">קבוצת "ועד" קשורה (אופציונלי)</label>
      <select id="linkedGroupId" name="linkedGroupId">
        <option value="">ללא</option>
        <% groups.forEach(function (g) { %>
          <option value="<%= g.id %>" <%= holiday.linkedGroupId === g.id ? 'selected' : '' %>><%= g.name %></option>
        <% }) %>
      </select>

      <label for="order">סדר תצוגה בארכיון</label>
      <input type="number" id="order" name="order" value="<%= holiday.order %>" />

      <label>
        <input type="checkbox" name="isFeatured" <%= holiday.isFeatured ? 'checked' : '' %> /> הצג כ"מועד הקרוב" בהבלטה בראש העמוד
      </label>

      <button type="submit">שמירת שינויים</button>
    </form>
    <p><a href="/holidays/<%= holiday.id %>">ביטול וחזרה</a></p>
  </main>
</body>
</html>
