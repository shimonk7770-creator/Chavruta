<!DOCTYPE html>
<!-- server/views/home.ejs - דף הבית - כולל אזור פתיחה (Hero) וקטגוריות ראשיות של האתר -->
<html lang="he" dir="rtl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">

    <!-- ===== אזור פתיחה - כותרת, טקסט הסבר ואיור SVG מוטמע (בלי תלות בקבצי תמונה חיצוניים) ===== -->
    <section class="hero">
      <div class="hero-text">
        <h1>ברוכים הבאים ל"חברותא"</h1>
        <p>
          רשת חברתית קהילתית - מקום אחד לשיעורים, קבוצות לימוד, דברי תורה, מעקב התקדמות וחיבור קהילתי.
        </p>
        <% if (!isLoggedIn) { %>
          <a class="btn btn-primary" href="/register">הצטרפו עכשיו</a>
          <a class="btn btn-secondary" href="/groups">גלו קבוצות</a>
        <% } else { %>
          <a class="btn btn-primary" href="/groups">לכל הקבוצות שלי</a>
        <% } %>
      </div>
      <div class="hero-image">
        <!-- איור פשוט של אנשים לומדים יחד סביב שולחן, מצויר כ-SVG -->
        <svg viewBox="0 0 320 240" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="160" cy="210" rx="130" ry="14" fill="#f0e4d0"/>
          <rect x="60" y="140" width="200" height="14" rx="7" fill="#c97b3c"/>
          <rect x="90" y="154" width="16" height="50" fill="#a85f27"/>
          <rect x="214" y="154" width="16" height="50" fill="#a85f27"/>
          <rect x="120" y="118" width="80" height="28" rx="4" fill="#fff" stroke="#1f6f5c" stroke-width="3"/>
          <line x1="160" y1="118" x2="160" y2="146" stroke="#1f6f5c" stroke-width="2"/>
          <circle cx="95" cy="95" r="22" fill="#f0c39a"/>
          <path d="M73 118c0-14 10-24 22-24s22 10 22 24" fill="#1f6f5c"/>
          <circle cx="225" cy="95" r="22" fill="#f0c39a"/>
          <path d="M203 118c0-14 10-24 22-24s22 10 22 24" fill="#c97b3c"/>
        </svg>
      </div>
    </section>

    <!-- ===== סרטון השראה - מוצג לכולם, גם אורחים, כדי שהעמוד ירגיש "חי" מהרגע הראשון ===== -->
    <section class="card video-feature">
      <h2>רגע של השראה</h2>
      <div class="video-embed-wrap">
        <iframe
          src="https://www.youtube.com/embed/ormF3yMohnI"
          title="סרטון השראה"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <!--
      ===== כרטיס "מה ההרשאות שלי" - מוצג רק למשתמש מחובר =====
      נועד לענות על שאלה נפוצה: "התחברתי, אבל מה אני יכול לעשות באתר?" - מסביר בקצרה
      את התפקיד (role) של המשתמש ואת ההרשאות הנובעות ממנו (ראו סעיף 3 ב-SRS ו-middleware/auth.js).
      userRole מגיע מ-res.locals (middleware גלובלי ב-server.js), ולכן זמין כאן גם בלי שהקונטרולר יעביר אותו במפורש.
    -->
    <% if (isLoggedIn) { %>
      <section class="card role-info-card">
        <h3>
          מה ההרשאות שלי באתר?
          <% if (userRole === 'admin') { %>
            <span class="role-badge">מנהל מערכת</span>
          <% } else if (userRole === 'manager') { %>
            <span class="role-badge">מנהל קבוצה</span>
          <% } else { %>
            <span class="role-badge">חבר קהילה</span>
          <% } %>
        </h3>
        <% if (userRole === 'admin') { %>
          <p>
            בתור מנהל מערכת תוכל: לנהל ולערוך כל קבוצה באתר (גם כזו שאינך מנהל בה ישירות),
            ליצור ולערוך מאמרי חג ותוכן קהילתי כללי, ולבצע כל פעולה שמנהל קבוצה רגיל יכול לבצע.
          </p>
        <% } else if (userRole === 'manager') { %>
          <p>
            בתור מנהל קבוצה תוכל: לערוך ולמחוק את הקבוצות שאתה מנהל בהן, לערוך או למחוק כל פוסט ותגובה
            בתוך הקבוצות שלך, ולנהל מי חבר בהן - וכמובן, להשתתף ככל חבר רגיל גם בשאר קבוצות האתר.
          </p>
        <% } else { %>
          <p>
            בתור חבר קהילה תוכל: להצטרף לקבוצות לימוד, לפרסם פוסטים ותגובות בקבוצות שאתה חבר בהן,
            לצ'וטט בזמן אמת עם שאר חברי הקבוצה, ולעקוב אחרי ההתקדמות האישית שלך במסך "מעקב לימוד".
            כדי לנהל קבוצה משלך, פשוט צור קבוצה חדשה - אתה הופך אוטומטית למנהל שלה.
          </p>
        <% } %>
        <p><a href="/permissions">קריאה מלאה על כל סוגי ההרשאות באתר ←</a></p>
      </section>
    <% } %>

    <!-- ===== קטגוריות ראשיות של האתר - ניווט מהיר לפי נושא ===== -->
    <section class="feature-grid">
      <a class="feature-card" href="/holidays">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
        <h3>מעגל השנה</h3>
        <p>מאמרים קצרים על מועדי ומנהגי השנה העברית - מה עושים ומה מתפללים בכל חג.</p>
      </a>
      <a class="feature-card" href="/groups">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.5 3-6 7-6s7 2.5 7 6"/><circle cx="17" cy="8" r="2.5"/><path d="M16 14.2c2.8.4 5 2.6 5 5.8"/></svg>
        <h3>קבוצות ושיעורים</h3>
        <p>מצאו קבוצת לימוד לפי נושא, יום ורמה, או הקימו קבוצה חדשה משלכם.</p>
      </a>
      <a class="feature-card" href="/posts/search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v12H7l-3 3V4z"/></svg>
        <h3>דברי תורה ועדכונים</h3>
        <p>שתפו רעיונות, שאלות ועדכוני קהילה, וקבלו תגובות בזמן אמת.</p>
      </a>
      <!-- קטגוריה: שיתוף וידאו בפוסטים (BR-008) - מדגישה יכולת שלרוב לא מצפים לה בפרויקט לימודי -->
      <a class="feature-card" href="/groups">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="14" height="14" rx="3"/><path d="M16 10l6-3v10l-6-3"/></svg>
        <h3>שיעורים בוידאו</h3>
        <p>צרפו קטעי וידאו לפוסטים - הקלטת שיעור, סיכום קצר או הדגמה - ישירות מהקבוצה שלכם.</p>
      </a>
      <a class="feature-card" href="<%= isLoggedIn ? '/register' : '/register' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>
        <h3>הצטרפות לקהילה</h3>
        <p>הרשמו בכמה שניות והתחילו להשתתף בקבוצות ובשיחות.</p>
      </a>
    </section>

  </main>

  <footer class="site-footer">חברותא &middot; פרויקט מסכם בפיתוח אתרים</footer>
</body>
</html>
