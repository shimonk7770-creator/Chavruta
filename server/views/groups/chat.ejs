<!DOCTYPE html>
<!-- server/views/groups/chat.ejs - צ'אט קבוצתי בזמן אמת (FR-021..FR-024) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
  <!-- הקובץ למטה נוצר ומוגש אוטומטית ע"י חבילת socket.io בצד השרת - אין צורך להוריד/להתקין אותו ידנית -->
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <h1>צ'אט - <%= group.name %></h1>
    <p class="meta">הצ'אט פתוח לחברי הקבוצה בלבד. הודעות נשמרות ונטענות מחדש בכל כניסה.</p>

    <div id="chat-messages" class="card chat-box" data-group-id="<%= group.id %>" data-user-id="<%= userId %>">
      <% if (!messages.length) { %>
        <!-- מצב ריק ידידותי - גם בצ'אט, לא רק בגרפים (ברוח FR-027) -->
        <p class="meta chat-empty">עדיין אין הודעות בקבוצה הזו. היו הראשונים לכתוב!</p>
      <% } %>
      <% messages.forEach(function(msg) { %>
        <div class="chat-message<%= msg.senderId === userId ? ' mine' : '' %>">
          <span class="chat-sender"><%= msg.senderName %></span>
          <!-- תוספת לפי משוב המשתמש (אוקטובר 2026): תמונה בהודעת צ'אט - אופציונלי, יכול להופיע גם בלי טקסט -->
          <% if (msg.imageUrl) { %>
            <a href="<%= msg.imageUrl %>" target="_blank" rel="noopener"><img src="<%= msg.imageUrl %>" class="chat-image" alt="תמונה בצ'אט" /></a>
          <% } %>
          <% if (msg.content) { %><span class="chat-content"><%= msg.content %></span><% } %>
        </div>
      <% }) %>
    </div>

    <p id="chat-typing-indicator" class="meta chat-typing" style="display:none"></p>
    <p id="chat-connection-status" class="meta chat-status"></p>

    <!-- תצוגה מקדימה לתמונה שנבחרה לפני שליחה (server/public/js/chat.js) -->
    <div id="chat-pending-image" class="chat-pending-image" style="display:none">
      <img id="chat-pending-image-thumb" src="" alt="תצוגה מקדימה" />
      <button type="button" id="chat-pending-image-remove" class="btn-link" title="הסרת התמונה">✕</button>
    </div>

    <form id="chat-form" class="comment-form chat-input-row">
      <button type="button" id="chat-emoji-btn" class="chat-icon-btn" title="הוספת אימוג'י">😀</button>
      <label for="chat-image-input" class="chat-icon-btn" title="שליחת תמונה">📷</label>
      <input type="file" id="chat-image-input" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
      <input type="text" id="chat-input" placeholder="כתבו הודעה..." maxlength="1000" autocomplete="off" />
      <button type="submit">שליחה</button>
    </form>
    <!-- פופאפ בחירת אימוג'י - רשימה סגורה וקבועה (בלי ספרייה/תלות חיצונית חדשה), מוצג/מוסתר ע"י chat.js -->
    <div id="chat-emoji-picker" class="chat-emoji-picker" style="display:none"></div>

    <p><a href="/groups/<%= group.id %>">חזרה לעמוד הקבוצה</a></p>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/chat.js"></script>
</body>
</html>
