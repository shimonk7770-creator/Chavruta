<!DOCTYPE html>
<!-- server/views/groups/show.ejs - עמוד קבוצה: פרטים, הצטרפות, פוסטים ותגובות (Ajax) -->
<!-- עדכון (בקשת המשתמש): עיצוב מחדש בהשראת וואטסאפ - כותרת עם תמונת קבוצה גדולה, רשימת חברים עם אווטארים,
     והוספת חברים ע"י מנהל הקבוצה (לא רק הצטרפות עצמית) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <% if (memberError) { %><p class="error-message"><%= memberError %></p><% } %>

    <!-- כותרת הקבוצה - תמונה עגולה גדולה + שם + מספר חברים, בהשראת כותרת קבוצה בוואטסאפ -->
    <section class="group-header">
      <% if (group.groupPhotoUrl) { %>
        <img class="group-avatar-lg" src="<%= group.groupPhotoUrl %>" alt="תמונת הקבוצה <%= group.name %>" />
      <% } else { %>
        <span class="group-avatar-lg group-avatar-fallback"><%= (group.name || '?').trim().charAt(0) %></span>
      <% } %>
      <div class="group-header-info">
        <h1><%= group.name %></h1>
        <p class="meta"><%= group.description %></p>
        <p class="meta">מנהל: <%= group.managerName %> | <%= group.members.length %> חברים</p>
      </div>
    </section>

    <% if (isManager) { %>
      <!-- העלאת/החלפת תמונת קבוצה - מנהל הקבוצה בלבד, אותו דפוס בדיוק כמו תמונת פרופיל -->
      <form action="/groups/<%= group.id %>/photo" method="POST" enctype="multipart/form-data" class="group-photo-form">
        <label for="groupPhoto">תמונת קבוצה (JPG/PNG/WEBP/GIF, עד 5MB)</label>
        <input type="file" id="groupPhoto" name="groupPhoto" accept="image/jpeg,image/png,image/webp,image/gif" required />
        <button type="submit">עדכון תמונת קבוצה</button>
      </form>
      <p><a href="/groups/<%= group.id %>/edit">עריכת פרטי הקבוצה</a></p>
    <% } %>

    <% if (isMember) { %>
      <!-- קישור לצ'אט הקבוצתי בזמן אמת (FR-021..FR-024), מוצג רק לחברי הקבוצה -->
      <a class="btn btn-secondary" href="/groups/<%= group.id %>/chat">כניסה לצ'אט הקבוצתי</a>
      <form action="/groups/<%= group.id %>/leave" method="POST" style="display:inline">
        <button type="submit">עזיבת הקבוצה</button>
      </form>
    <% } else { %>
      <form action="/groups/<%= group.id %>/join" method="POST" style="display:inline">
        <button type="submit">הצטרפות לקבוצה</button>
      </form>
    <% } %>

    <!-- רשימת חברי הקבוצה עם אווטארים - בהשראת "פרטי קבוצה" בוואטסאפ -->
    <h2>חברי הקבוצה</h2>
    <div class="member-list">
      <% memberUsers.forEach(function (m) { %>
        <span class="member-chip">
          <% if (m.avatarUrl) { %>
            <img class="avatar-thumb" src="<%= m.avatarUrl %>" alt="<%= m.fullName %>" />
          <% } else { %>
            <span class="avatar-thumb avatar-thumb-fallback"><%= (m.fullName || '?').trim().charAt(0) %></span>
          <% } %>
          <span><%= m.fullName %><% if (m.id === group.managerId) { %> <span class="role-badge">מנהל</span><% } %></span>
          <% if (isManager && m.id !== group.managerId) { %>
            <form action="/groups/<%= group.id %>/members/<%= m.id %>/remove" method="POST" onsubmit="return confirm('להסיר את <%= m.fullName %> מהקבוצה?')">
              <button type="submit" class="member-remove-btn" title="הסרה מהקבוצה">&times;</button>
            </form>
          <% } %>
        </span>
      <% }) %>
    </div>

    <% if (isManager) { %>
      <!-- הוספת חבר ע"י מנהל הקבוצה (בנוסף להצטרפות העצמית למעלה) - לפי שם משתמש -->
      <form action="/groups/<%= group.id %>/members" method="POST" class="add-member-form">
        <input type="text" name="username" placeholder="שם משתמש להוספה" required />
        <button type="submit">+ הוספת חבר</button>
      </form>
    <% } %>

    <hr />

    <% if (isMember) { %>
      <h2>פרסום פוסט חדש</h2>
      <form action="/groups/<%= group.id %>/posts" method="POST" class="auth-form">
        <input type="text" name="title" placeholder="כותרת" required maxlength="150" />
        <textarea name="content" placeholder="תוכן..." required maxlength="5000"></textarea>
        <select name="category">
          <option value="dvarTorah">דבר תורה</option>
          <option value="question">שאלה</option>
          <option value="update">עדכון</option>
        </select>
        <button type="submit">פרסום</button>
      </form>
    <% } %>

    <h2>פוסטים בקבוצה</h2>
    <% posts.forEach(function(post) { %>
      <div class="card post-card" data-post-id="<%= post.id %>">
        <h3><%= post.title %></h3>
        <p class="meta"><%= post.authorName %> | <%= post.category %></p>
        <p><%= post.content %></p>
        <!-- נגן הוידאו המצורף לפוסט (BR-008) - העיצוב מגיע מ-.post-video ב-style.css, לא inline -->
        <% if (post.videoUrl) { %>
          <video class="post-video" controls src="<%= post.videoUrl %>"></video>
        <% } %>
        <!-- גלריית תמונות מצורפות לפוסט (עד 6, ראו server/models/Post.js addImages) -->
        <% if (post.imageUrls && post.imageUrls.length) { %>
          <div class="image-gallery">
            <% post.imageUrls.forEach(function (url) { %>
              <a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" class="gallery-thumb" alt="תמונה מצורפת לפוסט" /></a>
            <% }) %>
          </div>
        <% } %>

        <!-- קישורי ניהול פוסט - מוצגים רק לבעל הפוסט או למנהל הקבוצה (בדיקת ההרשאה האמיתית מתבצעת בשרת ב-middleware canModifyPost) -->
        <% if (isManager || post.authorId === userId) { %>
          <p class="meta">
            <a href="/posts/<%= post.id %>/edit">עריכה</a>
            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display:inline">
              <button type="submit" class="btn-link">מחיקה</button>
            </form>
          </p>
        <% } %>

        <!-- אזור התגובות - נטען ומתעדכן דרך jQuery/Ajax, ללא רענון עמוד (דרישה 25) -->
        <div class="comments-list" id="comments-<%= post.id %>"></div>
        <form class="comment-form" data-post-id="<%= post.id %>">
          <input type="text" name="content" placeholder="כתוב תגובה..." maxlength="1000" required />
          <button type="submit">שלח</button>
        </form>
      </div>
    <% }) %>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/comments.js"></script>
</body>
</html>
