<!DOCTYPE html>
<!-- server/views/groups/show.ejs - עמוד קבוצה: פרטים, הצטרפות, פוסטים ותגובות (Ajax) -->
<!-- עדכון (בקשת המשתמש): עיצוב מחדש בהשראת וואטסאפ - כותרת עם תמונת קבוצה גדולה, רשימת חברים עם אווטארים,
     והוספת חברים ע"י מנהל הקבוצה (לא רק הצטרפות עצמית) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
  <!-- עיצוב רכיבי ה-AI (סיכום פוסט + שאלות) -->
  <link rel="stylesheet" href="/css/ai.css" />
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <% if (memberError) { %><p class="error-message"><%= memberError %></p><% } %>

    <!-- כותרת הקבוצה - תמונה עגולה גדולה + שם + מספר חברים, בהשראת כותרת קבוצה בוואטסאפ -->
    <section class="group-header">
      <% if (group.groupPhotoUrl) { %>
        <img class="group-avatar-lg" src="<%= group.groupPhotoUrl %>" alt="תמונת הקבוצה <%= group.name %>" />
      <% } else { %>
        <span class="group-avatar-lg group-avatar-fallback"><%= section ? section.emoji : (group.name || '?').trim().charAt(0) %></span>
      <% } %>
      <div class="group-header-info">
        <h1><%= group.name %></h1>
        <p class="meta"><%= group.description %></p>
        <p class="meta">מנהל: <%= group.managerName %> | <%= group.members.length %> חברים</p>
      </div>
    </section>

    <!-- באנר תפקיד מוחשי: מה אני יכול לעשות בקבוצה הזו עכשיו (ההרשאות נאכפות בשרת, זה רק הסבר למשתמש) -->
    <p class="role-banner role-banner-<%= !userId ? 'guest' : (isAdmin ? 'admin' : (isManager ? 'manager' : (isMember ? 'member' : 'guest'))) %>">
      <% if (!userId) { %>
        👀 אתה גולש כאורח - אפשר לקרוא. כדי להצטרף ולפרסם צריך <a href="/login">להתחבר</a>.
      <% } else if (isAdmin) { %>
        🛡️ מנהל מערכת: אפשר לערוך ולהסיר כל פוסט ותגובה כאן ולנהל את הקבוצה.
      <% } else if (isManager) { %>
        ⭐ אתה מנהל הקבוצה: אפשר להסיר כל פוסט ותגובה כאן ולנהל חברים.
      <% } else if (isMember) { %>
        ✅ אתה חבר בקבוצה: אפשר לפרסם, להגיב ולדווח על תוכן לא ראוי.
      <% } else { %>
        👤 עוד לא חבר: הצטרף כדי לפרסם ולהגיב.
      <% } %>
    </p>
    <% if (section) { %>
      <p class="meta">📌 <strong>מה מתאים להעלות כאן:</strong> <%= section.topicHint.split(':')[0] %>. Gemini בודק שהתוכן מתאים למדור לפני הפרסום.</p>
      <% if (section.key === 'minyan') { %>
        <p><a class="btn btn-secondary" href="/minyanim">🙋 מניינים קרובים וסימון "אני מגיע"</a> <a class="btn" href="/zmanim">🕐 זמני היום והמניינים של היום</a></p>
      <% } %>
    <% } %>

    <% if (isManager) { %>
      <!-- העלאת/החלפת תמונת קבוצה - מנהל הקבוצה בלבד, אותו דפוס בדיוק כמו תמונת פרופיל -->
      <form action="/groups/<%= group.id %>/photo" method="POST" enctype="multipart/form-data" class="group-photo-form">
        <label for="groupPhoto">תמונת קבוצה (JPG/PNG/WEBP/GIF, עד 5MB)</label>
        <input type="file" id="groupPhoto" name="groupPhoto" accept="image/jpeg,image/png,image/webp,image/gif" required />
        <button type="submit">עדכון תמונת קבוצה</button>
      </form>
      <p><a href="/groups/<%= group.id %>/edit">עריכת פרטי הקבוצה</a></p>
    <% } %>

    <% if (isMember) { %>
      <!-- קישור לצ'אט הקבוצתי בזמן אמת (FR-021..FR-024), מוצג רק לחברי הקבוצה -->
      <a class="btn btn-secondary" href="/groups/<%= group.id %>/chat">כניסה לצ'אט הקבוצתי</a>
      <form action="/groups/<%= group.id %>/leave" method="POST" style="display:inline">
        <button type="submit">עזיבת הקבוצה</button>
      </form>
    <% } else { %>
      <form action="/groups/<%= group.id %>/join" method="POST" style="display:inline">
        <button type="submit">הצטרפות לקבוצה</button>
      </form>
    <% } %>

    <!-- רשימת חברי הקבוצה עם אווטארים - בהשראת "פרטי קבוצה" בוואטסאפ -->
    <h2>חברי הקבוצה</h2>
    <div class="member-list">
      <% memberUsers.forEach(function (m) { %>
        <span class="member-chip">
          <% if (m.avatarUrl) { %>
            <img class="avatar-thumb" src="<%= m.avatarUrl %>" alt="<%= m.fullName %>" />
          <% } else { %>
            <span class="avatar-thumb avatar-thumb-fallback"><%= (m.fullName || '?').trim().charAt(0) %></span>
          <% } %>
          <span><%= m.fullName %><% if (m.id === group.managerId) { %> <span class="role-badge">מנהל</span><% } %></span>
          <% if (isManager && m.id !== group.managerId) { %>
            <form action="/groups/<%= group.id %>/members/<%= m.id %>/remove" method="POST" onsubmit="return confirm('להסיר את <%= m.fullName %> מהקבוצה?')">
              <button type="submit" class="member-remove-btn" title="הסרה מהקבוצה">&times;</button>
            </form>
          <% } %>
        </span>
      <% }) %>
    </div>

    <% if (isManager) { %>
      <!-- הוספת חבר ע"י מנהל הקבוצה (בנוסף להצטרפות העצמית למעלה) - לפי שם משתמש -->
      <form action="/groups/<%= group.id %>/members" method="POST" class="add-member-form">
        <input type="text" name="username" placeholder="שם משתמש להוספה" required />
        <button type="submit">+ הוספת חבר</button>
      </form>
    <% } %>

    <hr />

    <% if (isMember) { %>
      <!-- עוצב מחדש לפי משוב המשתמש (אוקטובר 2026): טופס פרסום פוסט מושך ויזואלית יותר, כולל צירוף תמונות כבר בזמן הפרסום -->
      <section class="card new-post-card">
        <h2>✨ פרסום פוסט חדש</h2>
        <form action="/groups/<%= group.id %>/posts" method="POST" enctype="multipart/form-data" class="auth-form new-post-form">
          <label for="postTitle">כותרת</label>
          <input type="text" id="postTitle" name="title" placeholder="על מה תרצה לכתוב?" required maxlength="150" />

          <label for="postContent">תוכן</label>
          <textarea id="postContent" data-voice name="content" placeholder="שתף דבר תורה, שאלה, או עדכון עם הקבוצה..." required maxlength="5000"></textarea>

          <!-- עזרה בכתיבה (AI): שיפור ניסוח של הטיוטה / הצעת כותרות. לא מפרסם ולא שומר כלום - רק מציע -->
          <div class="compose-tools">
            <div class="ai-row">
              <button type="button" class="ai-summary-btn compose-btn" data-mode="improve">✨ שפר ניסוח</button>
              <button type="button" class="ai-summary-btn compose-btn" data-mode="title">💡 הצע כותרת</button>
            </div>
            <div class="ai-answer" id="compose-box" role="status" aria-live="polite"></div>
          </div>

          <label>סוג הפוסט</label>
          <div class="post-category-pills">
            <label class="option-pill category-pill">
              <input type="radio" name="category" value="dvarTorah" checked /> 📖 דבר תורה
            </label>
            <label class="option-pill category-pill">
              <input type="radio" name="category" value="question" /> ❓ שאלה
            </label>
            <label class="option-pill category-pill">
              <input type="radio" name="category" value="update" /> 📢 עדכון
            </label>
          </div>

          <label for="postImages">תמונות (אופציונלי, עד 6)</label>
          <input type="file" id="postImages" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
          <div class="post-image-preview" id="postImagePreview"></div>

          <button type="submit">📤 פרסום</button>
        </form>
      </section>
    <% } %>

    <% if (userId) { %>
      <!-- פיצ'ר AI (דרישת המרצה #2): שאלה על תוכן הקבוצה כולה - נשלחת לשרת, שפונה ל-Gemini (המפתח לעולם לא מגיע לדפדפן) -->
      <section class="card ai-group-card">
        <h2>🤖 שאל את ה-AI על הקבוצה</h2>
        <p class="meta">ה-AI עונה לפי הפוסטים האחרונים בקבוצה הזו.</p>
        <form class="ai-ask-form ai-group-form" data-group-id="<%= group.id %>">
          <input type="text" name="question" placeholder="למשל: על מה למדנו לאחרונה?" maxlength="500" required />
          <button type="submit" class="ai-summary-btn">שאל</button>
        </form>
        <div class="ai-answer" id="ai-group-box" role="status" aria-live="polite"></div>
      </section>
    <% } %>

    <h2>פוסטים בקבוצה</h2>
    <% posts.forEach(function(post) { %>
      <div class="card post-card" id="post-<%= post.id %>" data-post-id="<%= post.id %>">
        <div class="post-card-header">
          <span class="post-category-badge post-category-<%= post.category %>">
            <%= post.category === 'dvarTorah' ? '📖 דבר תורה' : post.category === 'question' ? '❓ שאלה' : '📢 עדכון' %>
          </span>
          <span class="meta post-author"><%= post.authorName %></span>
        </div>
        <h3><%= post.title %></h3>
        <p class="post-content"><%= post.content %></p>
        <% if (post.aiCheck === 'unchecked' && isManager) { %>
          <p class="meta">⚠️ פורסם בלי בדיקת AI - ממתין לאישור מנהל</p>
        <% } %>
        <!-- נגן הוידאו המצורף לפוסט (BR-008) - העיצוב מגיע מ-.post-video ב-style.css, לא inline -->
        <% if (post.videoUrl) { %>
          <video class="post-video" controls src="<%= post.videoUrl %>"></video>
        <% } %>
        <!-- גלריית תמונות מצורפות לפוסט (עד 6, ראו server/models/Post.js addImages) -->
        <% if (post.imageUrls && post.imageUrls.length) { %>
          <div class="image-gallery">
            <% post.imageUrls.forEach(function (url) { %>
              <a href="<%= url %>" target="_blank" rel="noopener"><img src="<%= url %>" class="gallery-thumb" alt="תמונה מצורפת לפוסט" /></a>
            <% }) %>
          </div>
        <% } %>

        <% if (userId) { %>
          <!-- כלי AI לפוסט: סיכום (נשמר ב-DB אחרי הפעם הראשונה) + שאלה על הפוסט. התשובה מוצגת בתיבה מתחת (public/js/ai.js) -->
          <div class="ai-tools">
            <div class="ai-row">
              <button type="button" class="ai-summary-btn" data-post-id="<%= post.id %>">✨ סכם</button>
              <form class="ai-ask-form ai-post-form" data-post-id="<%= post.id %>">
                <input type="text" name="question" placeholder="שאל את ה-AI על הפוסט..." maxlength="500" required />
                <button type="submit" class="ai-summary-btn">שאל</button>
              </form>
            </div>
            <div class="ai-answer" id="ai-box-<%= post.id %>" role="status" aria-live="polite"></div>
          </div>
        <% } %>

        <!-- קישורי ניהול פוסט - מוצגים רק לבעל הפוסט או למנהל הקבוצה (בדיקת ההרשאה האמיתית מתבצעת בשרת ב-middleware canModifyPost) -->
        <!-- שורת אינטראקציה כמו ברשתות חברתיות: ❤️ אהבתי (Ajax) + 🔗 שיתוף (Web Share / העתקת קישור) -->
        <% const likers = Array.isArray(post.likedBy) ? post.likedBy : []; %>
        <div class="post-actions">
          <button type="button" class="like-btn<%= userId && likers.includes(userId) ? ' liked' : '' %>" data-kind="post" data-id="<%= post.id %>"<%= userId ? '' : ' disabled title="יש להתחבר כדי לתת לייק"' %>>
            <span class="like-heart"><%= userId && likers.includes(userId) ? '❤️' : '🤍' %></span> <span class="like-count"><%= likers.length %></span>
          </button>
          <button type="button" class="share-btn" data-url="/groups/<%= group.id %>#post-<%= post.id %>" data-title="<%= post.title %>">🔗 שתף</button>
        </div>
        <% if (userId && post.authorId !== userId) { %>
          <button type="button" class="btn-link report-btn" data-type="post" data-id="<%= post.id %>">🚩 דווח</button>
        <% } %>
        <% if (isManager || post.authorId === userId) { %>
          <p class="meta">
            <a href="/posts/<%= post.id %>/edit">עריכה</a>
            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display:inline">
              <button type="submit" class="btn-link">מחיקה</button>
            </form>
          </p>
        <% } %>

        <!-- אזור התגובות - נטען ומתעדכן דרך jQuery/Ajax, ללא רענון עמוד (דרישה 25) -->
        <div class="comments-list" id="comments-<%= post.id %>"></div>
        <form class="comment-form" data-post-id="<%= post.id %>">
          <input type="text" name="content" data-voice placeholder="כתוב תגובה..." maxlength="1000" required />
          <button type="submit">שלח</button>
        </form>
      </div>
    <% }) %>
  </main>

  <%- include('../partials/footer') %>

  <script>window.CURRENT_USER_ID = <%- JSON.stringify(userId || '') %>;</script>
  <script src="/js/report.js"></script>
  <script src="/js/likes.js"></script>
  <script src="/js/voice.js"></script>
  <script src="/js/comments.js"></script>
  <script src="/js/postForm.js"></script>
  <script src="/js/ai.js"></script>
  <script src="/js/aiCompose.js"></script>
</body>
</html>
