<!DOCTYPE html>
<!-- server/views/groups/edit.ejs - טופס עריכת קבוצה (FR-007) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h1>עריכת קבוצה</h1>
    <% if (error) { %><p class="error-message"><%= error %></p><% } %>
    <form action="/groups/<%= group.id %>?_method=PUT" method="POST" class="auth-form">
      <label for="name">שם הקבוצה</label>
      <input type="text" id="name" name="name" required value="<%= group.name %>" />

      <label for="description">תיאור</label>
      <textarea id="description" name="description"><%= group.description %></textarea>

      <label for="topic">נושא</label>
      <input type="text" id="topic" name="topic" value="<%= group.topic %>" />

      <label for="dayOfWeek">יום בשבוע</label>
      <input type="text" id="dayOfWeek" name="dayOfWeek" value="<%= group.dayOfWeek %>" />

      <label for="time">שעה</label>
      <input type="text" id="time" name="time" value="<%= group.time %>" />

      <button type="submit">שמירה</button>
    </form>

    <form action="/groups/<%= group.id %>?_method=DELETE" method="POST" onsubmit="return confirm('למחוק את הקבוצה לצמיתות?')">
      <button type="submit" style="background-color:#b3261e">מחיקת הקבוצה</button>
    </form>
  </main>
</body>
</html>
