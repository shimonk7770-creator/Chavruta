<!DOCTYPE html>
<!-- server/views/groups/index.ejs - רשימת/חיפוש קבוצות (FR-010, FR-011) -->
<!-- עדכון (בקשת המשתמש): עיצוב מחדש בהשראת וואטסאפ - רשימת שורות עם תמונת קבוצה עגולה, במקום כרטיסי טקסט פשוטים -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <h1>🕍 בית חב״ד</h1>
    <p class="meta">כל הקהילה במקום אחד: בוחרים מדור, מצטרפים ומשתתפים. אפשר להיות חבר במדור אחד מכל סוג.</p>

    <!-- עדכון (משוב המרצה): מדורים קבועים במקום קבוצות מפוזרות. בכל כרטיס: אימוג'י, שם, תיאור, כמות חברים וסימון "אני חבר" -->
    <% if (sections && sections.length) { %>
      <div class="section-grid">
        <% sections.forEach(function(item) { %>
          <a class="section-card <%= item.group.members.includes(userId) ? 'is-member' : '' %>" href="/groups/<%= item.group.id %>">
            <span class="section-emoji" aria-hidden="true"><%= item.def.emoji %></span>
            <span class="section-name"><%= item.group.name %></span>
            <span class="section-desc"><%= item.group.description %></span>
            <span class="section-meta">
              <span><%= item.group.members.length %> חברים</span>
              <% if (item.group.members.includes(userId)) { %><span class="section-joined">✓ אני חבר/ה</span><% } %>
            </span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <h2><%= sections && sections.length ? 'קבוצות נוספות וחיפוש' : 'חיפוש קבוצות' %></h2>

    <!-- טופס חיפוש - GET רגיל (לא Ajax) לפשטות, אפשר לשדרג ל-Ajax בהמשך -->
    <form action="/groups/search" method="GET" class="search-form">
      <input type="text" name="topic" placeholder="נושא" value="<%= query.topic || '' %>" />
      <select name="dayOfWeek">
        <option value="">כל יום</option>
        <% ['ראשון','שני','שלישי','רביעי','חמישי','שישי','שבת'].forEach(function(day) { %>
          <option value="<%= day %>" <%= query.dayOfWeek === day ? 'selected' : '' %>><%= day %></option>
        <% }) %>
      </select>
      <select name="level">
        <option value="">כל הרמות</option>
        <option value="beginners" <%= query.level === 'beginners' ? 'selected' : '' %>>מתחילים</option>
        <option value="intermediate" <%= query.level === 'intermediate' ? 'selected' : '' %>>בינוני</option>
        <option value="advanced" <%= query.level === 'advanced' ? 'selected' : '' %>>מתקדמים</option>
      </select>
      <button type="submit">חיפוש</button>
    </form>

    <% if (groups.length === 0 && !(sections && sections.length)) { %>
      <p class="meta">לא נמצאו קבוצות התואמות את החיפוש. נסה להרחיב את הקריטריונים.</p>
    <% } else if (groups.length === 0) { %>
      <p class="meta">אין כרגע קבוצות נוספות מעבר למדורי בית חב״ד.</p>
    <% } %>

    <!-- רשימת קבוצות בסגנון "רשימת שיחות" של וואטסאפ - שורה לכל קבוצה, תמונה עגולה + שם + תיאור קצר + תגית חברים -->
    <div class="group-list">
      <% groups.forEach(function(group) { %>
        <a class="group-row" href="/groups/<%= group.id %>">
          <% if (group.groupPhotoUrl) { %>
            <img class="group-avatar" src="<%= group.groupPhotoUrl %>" alt="תמונת הקבוצה <%= group.name %>" />
          <% } else { %>
            <span class="group-avatar group-avatar-fallback"><%= (group.name || '?').trim().charAt(0) %></span>
          <% } %>
          <span class="group-row-info">
            <span class="group-row-name"><%= group.name %></span>
            <span class="group-row-sub">
              <% if (group.topic) { %><%= group.topic %><% } else { %><%= group.description || 'קבוצה בחברותא' %><% } %>
              <% if (group.dayOfWeek || group.time) { %> &middot; <%= group.dayOfWeek %> <%= group.time %><% } %>
            </span>
          </span>
          <span class="group-row-badge"><%= group.members.length %> חברים</span>
        </a>
      <% }) %>
    </div>

    <!-- כפתור "יצירת קבוצה" צף (FAB) - בהשראת כפתור הצ'אט החדש בוואטסאפ -->
    <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
      <a href="/groups/new" class="fab-new-group" title="יצירת קבוצה חדשה (אדמין)">+</a>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
