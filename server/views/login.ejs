<!DOCTYPE html>
<!-- server/views/login.ejs - טופס התחברות -->
<html lang="he" dir="rtl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container auth-page">
    <h1>התחברות</h1>

    <% if (error) { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <form action="/login" method="POST" class="auth-form">
      <label for="email">אימייל</label>
      <input type="email" id="email" name="email" required value="<%= typeof email !== 'undefined' ? email : '' %>" />

      <label for="password">סיסמה</label>
      <!-- אותה עטיפת password-wrapper כמו בטופס ההרשמה, לעקביות עיצובית (server/public/js/passwordToggle.js) -->
      <div class="password-wrapper">
        <input type="password" id="password" name="password" required />
        <button type="button" class="toggle-password-btn" aria-label="הצג סיסמה">👁️</button>
      </div>

      <button type="submit">התחברות</button>
    </form>
  </main>

  <script src="/js/passwordToggle.js"></script>
</body>
</html>
