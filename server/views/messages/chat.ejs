<!DOCTYPE html>
<!-- server/views/messages/chat.ejs - צ'אט פרטי (1-על-1) בזמן אמת - אותו רעיון בדיוק כמו groups/chat.ejs -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
  <!-- הקובץ למטה נוצר ומוגש אוטומטית ע"י חבילת socket.io בצד השרת - אין צורך להוריד/להתקין אותו ידנית -->
  <script src="/socket.io/socket.io.js"></script>
</head>
<body>
  <%- include('../partials/header') %>

  <main class="container">
    <div class="dm-chat-header">
      <% if (otherUser.avatarUrl) { %>
        <img class="avatar-thumb" src="<%= otherUser.avatarUrl %>" alt="<%= otherUser.fullName %>" style="width:40px;height:40px" />
      <% } else { %>
        <span class="avatar-thumb avatar-thumb-fallback" style="width:40px;height:40px"><%= (otherUser.fullName || '?').trim().charAt(0) %></span>
      <% } %>
      <h1>שיחה עם <%= otherUser.fullName %></h1>
    </div>
    <p class="meta">הודעות נשמרות ונטענות מחדש בכל כניסה - רק שני הצדדים רואים את השיחה הזו.</p>

    <div id="chat-messages" class="card chat-box" data-other-user-id="<%= otherUser.id %>" data-user-id="<%= userId %>">
      <% if (!messages.length) { %>
        <p class="meta chat-empty">עדיין אין הודעות בשיחה הזו. כתבו משהו!</p>
      <% } %>
      <% messages.forEach(function(msg) { %>
        <div class="chat-message<%= msg.senderId === userId ? ' mine' : '' %>">
          <span class="chat-sender"><%= msg.senderName %></span>
          <span class="chat-content"><%= msg.content %></span>
        </div>
      <% }) %>
    </div>

    <p id="chat-typing-indicator" class="meta chat-typing" style="display:none"></p>
    <p id="chat-connection-status" class="meta chat-status"></p>

    <form id="chat-form" class="comment-form">
      <input type="text" id="chat-input" placeholder="כתבו הודעה..." maxlength="1000" autocomplete="off" required />
      <button type="submit">שליחה</button>
    </form>

    <p><a href="/messages">חזרה לתיבת ההודעות</a></p>
  </main>

  <%- include('../partials/footer') %>

  <script src="/js/dmChat.js"></script>
</body>
</html>
