<!DOCTYPE html>
<!-- server/views/profile.ejs - עריכת פרופיל אישי ומחיקת חשבון (FR-004, FR-005) -->
<html lang="he" dir="rtl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <h1>הפרופיל שלי</h1>

    <% if (typeof error !== 'undefined' && error) { %><p class="error-message"><%= error %></p><% } %>
    <% if (typeof success !== 'undefined' && success) { %><p style="color:var(--color-secondary)"><%= success %></p><% } %>

    <!-- תמונת פרופיל - תצוגה מקדימה + העלאת קובץ אמיתי (בנוסף לאפשרות הישנה של הדבקת קישור למטה) -->
    <h2>תמונת פרופיל</h2>
    <% if (profileUser.avatarUrl) { %>
      <img class="avatar-preview" src="<%= profileUser.avatarUrl %>" alt="תמונת הפרופיל שלי" />
    <% } else { %>
      <p class="meta">עדיין לא הועלתה תמונת פרופיל.</p>
    <% } %>
    <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="auth-form">
      <label for="avatar">בחירת תמונה חדשה (JPG/PNG/WEBP/GIF, עד 5MB)</label>
      <input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" required />
      <button type="submit">העלאת תמונת פרופיל</button>
    </form>

    <hr />

    <form action="/profile" method="POST" class="auth-form">
      <label for="fullName">שם מלא</label>
      <input type="text" id="fullName" name="fullName" value="<%= profileUser.fullName %>" required />

      <label for="bio">קצת עליי</label>
      <textarea id="bio" name="bio" maxlength="300"><%= profileUser.bio %></textarea>

      <label for="avatarUrl">קישור לתמונת פרופיל (אופציונלי - חלופה להעלאת קובץ למעלה)</label>
      <input type="text" id="avatarUrl" name="avatarUrl" value="<%= profileUser.avatarUrl %>" />

      <!--
        עיר לזמני שבת - כרטיס "זמני שבת" בדף הבית (server/utils/shabbatTimes.js).
        תפריט נפתח סגור (לא טופס טקסט חופשי) כדי שכל בחירה תהיה עיר אמיתית עם קואורדינטות תקינות -
        ראו הסבר מפורט בהערות בראש shabbatTimes.js לגבי הסיבה לבחירה הזו.
      -->
      <label for="shabbatCity">עיר לזמני שבת</label>
      <select id="shabbatCity" name="shabbatCity">
        <% (typeof cityOptions !== 'undefined' ? cityOptions : []).forEach(function(city) { %>
          <option value="<%= city.key %>" <%= profileUser.shabbatCity === city.key ? "selected" : "" %>><%= city.label %></option>
        <% }) %>
      </select>

      <hr />
      <p class="meta">שינוי סיסמה (השאר ריק אם אינך רוצה לשנות):</p>
      <label for="currentPassword">סיסמה נוכחית</label>
      <input type="password" id="currentPassword" name="currentPassword" />

      <label for="newPassword">סיסמה חדשה</label>
      <input type="password" id="newPassword" name="newPassword" />

      <button type="submit">שמירת שינויים</button>
    </form>

    <hr />
    <!--
      ===== התאמה אישית - גודל טקסט =====
      רעיון הועבר מפרויקט React נפרד ("חת"ת יומי") שהמשתמש בנה בעבר. נשמר בדפדפן (localStorage) בלבד -
      זו העדפת תצוגה אישית של המכשיר, לא נתון שצריך לסנכרן בין מכשירים דרך השרת/Firestore.
      server/public/js/fontSize.js מטפל בלחיצות ובשמירה; partials/head.ejs מיישם את הגודל השמור
      מוקדם ככל האפשר (לפני טעינת ה-CSS) כדי למנוע הבהוב של גודל טקסט שגוי ברגע הטעינה.
    -->
    <h2>התאמה אישית - גודל טקסט</h2>
    <p class="meta">הבחירה נשמרת במכשיר הזה בלבד, ומשפיעה על גודל הטקסט בכל האתר.</p>
    <div class="option-pill-row" id="font-size-row">
      <button type="button" class="option-pill" data-font-size="normal">רגיל</button>
      <button type="button" class="option-pill" data-font-size="large">גדול</button>
      <button type="button" class="option-pill" data-font-size="xlarge">גדול מאוד</button>
    </div>

    <hr />
    <h2>מחיקת חשבון</h2>
    <p class="meta">מחיקת החשבון היא רכה - הפרופיל יושבת, אך תוכן שפרסמת (פוסטים/תגובות) יישאר קיים לצורך שלמות ההיסטוריה של אחרים.</p>
    <form action="/profile/delete" method="POST" onsubmit="return confirm('האם אתה בטוח שברצונך למחוק את החשבון?')">
      <button type="submit" style="background-color:#b3261e">מחיקת החשבון שלי</button>
    </form>
  </main>

  <%- include('partials/footer') %>

  <script src="/js/fontSize.js"></script>
</body>
</html>
