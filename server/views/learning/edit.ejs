<!DOCTYPE html>
<!-- server/views/learning/edit.ejs - עריכת רישום לימוד (FR-019) -->
<html lang="he" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>
  <main class="container">
    <h1>עריכת רישום לימוד</h1>
    <% if (error) { %><p class="error-message"><%= error %></p><% } %>
    <form action="/learning/<%= log.id %>?_method=PUT" method="POST" class="auth-form">
      <label for="date">תאריך</label>
      <input type="date" id="date" name="date" required
        value="<%= new Date(log.date.toDate ? log.date.toDate() : log.date).toISOString().slice(0,10) %>" />

      <label for="unit">מה נלמד</label>
      <input type="text" id="unit" name="unit" required maxlength="150" value="<%= log.unit %>" />

      <label for="notes">הערות</label>
      <textarea id="notes" name="notes" maxlength="500"><%= log.notes %></textarea>

      <button type="submit">שמירת שינויים</button>
    </form>
    <p><a href="/learning">חזרה לרשימה</a></p>
  </main>
</body>
</html>
