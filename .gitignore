# תלויות - לא נשמרות בגיט, מותקנות מחדש עם npm install
node_modules/

# משתני סביבה - מכילים סודות - אסור להעלות לגיט!
.env

# מפתח שירות של Firebase (Service Account) - מעניק גישה מלאה למסד הנתונים - סוד רגיש ביותר!
serviceAccountKey.json

# קבצי לוג
*.log
npm-debug.log*

# קבצים של מערכת ההפעלה / עורך
.DS_Store
.vscode/
Thumbs.db

# שאריות מפרויקט Next.js קודם שלא קשור
.next/

# קבצי וידאו שהועלו על ידי משתמשים - לא נשמרים בגיט (קבצים בינאריים כבדים), רק הנתיב נשמר ב-Firestore
uploads/*
!uploads/.gitkeep
