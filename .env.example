# העתק קובץ זה ל-.env ומלא ערכים אמיתיים (קובץ .env לא נשמר בגיט!)

# פורט שהשרת יאזין עליו
PORT=3000

# מפתח סודי להצפנת ה-session - כל מחרוזת אקראית וארוכה
SESSION_SECRET=change_this_to_a_long_random_string

# --- Firebase / Firestore ---
# יש להוריד קובץ מפתח שירות (Service Account) מ-Firebase Console:
# Project Settings -> Service Accounts -> Generate new private key
# לשמור את הקובץ שהתקבל בשם serviceAccountKey.json בשורש הפרויקט (ליד קובץ זה)
# הקובץ הזה לא נשמר בגיט (ראו .gitignore) - הוא מכיל סוד רגיש!

# --- פיצ'ר AI (Gemini) ---
# מפתח API חינמי: https://aistudio.google.com/apikey  (לכתוב כאן בלבד - לעולם לא בצ'אט/בקוד/בגיט!)
GEMINI_API_KEY=
# אופציונלי: שם המודל. אם לא מוגדר - ברירת המחדל מוגדרת ב-server/services/aiService.js
# GEMINI_MODEL=gemini-3.6-flash
# אופציונלי: מודלי גיבוי (מופרדים בפסיק). אם המודל הראשי עמוס (503) / חצה מכסה (429) / לא קיים - השרת מנסה אוטומטית את הבאים בתור.
# אם לא מוגדר - ברירת המחדל: gemini-flash-lite-latest,gemini-3-flash-preview
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
# אופציונלי: זמן המתנה מקסימלי לתשובה ממודל בודד, באלפיות שנייה (ברירת מחדל 60000)
# GEMINI_TIMEOUT_MS=60000

# --- התחברות עם Google (Firebase Authentication) ---
# 1) ב-Firebase Console: Authentication -> Sign-in method -> להפעיל "Google".
# 2) Project settings -> General -> "Your apps" -> להוסיף אפליקציית Web (</>) ולהעתיק את ה-apiKey לכאן.
#    (מפתח Web של Firebase אינו סוד, אבל לא שומרים אותו בגיט - רק ב-.env)
# 3) Authentication -> Settings -> Authorized domains: וודאו ש-localhost ברשימה (ברירת מחדל כן).
# בלי FIREBASE_WEB_API_KEY כפתור Google פשוט לא מוצג והכניסה הרגילה עובדת כרגיל.
FIREBASE_WEB_API_KEY=
# אופציונלי: ברירת מחדל <project_id>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=
